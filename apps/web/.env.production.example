# =============================================================================
# WEB (Next.js) — Production environment variables
# =============================================================================
# Copy these into your hosting provider (Vercel / Netlify / etc.) env settings.
# NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.

# Public site URL — used for SEO (sitemap, robots, canonical, Open Graph).
NEXT_PUBLIC_APP_URL=https://connect.adyapan.com
# Backend API URL (your deployed API domain).
NEXT_PUBLIC_API_URL=https://api.adyapan.com
NEXT_PUBLIC_APP_NAME=Adyapan Connect
