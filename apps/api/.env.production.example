# =============================================================================
# API (NestJS) — Production environment variables
# =============================================================================
# Set these in your hosting provider (Render / Railway / Fly / ECS / etc.).
# Do NOT commit real secrets. This file is a template only.

NODE_ENV=production
PORT=4000
APP_URL=https://connect.adyapan.com
API_URL=https://api.adyapan.com

# --- Database (Supabase) --------------------------------------------------
# Pooled connection (PgBouncer, port 6543) for the running app.
DATABASE_URL=postgresql://postgres.kqotujuhswoofgxtmrfv:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) used by Prisma for migrations.
DATABASE_DIRECT_URL=postgresql://postgres.kqotujuhswoofgxtmrfv:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Redis (required for BullMQ queues) -----------------------------------
# Use a managed Redis (Upstash / Redis Cloud / provider add-on).
REDIS_URL=redis://default:PASSWORD@your-redis-host:6379
REDIS_PASSWORD=

# --- Auth secrets (generate fresh 48-byte values for production) ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-32-character-key-here!!

# --- Meta / WhatsApp Business API -----------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v19.0
META_GRAPH_API_URL=https://graph.facebook.com

# --- AI -------------------------------------------------------------------
OPENAI_API_KEY=

# --- CORS (comma-separated allowed origins) -------------------------------
CORS_ORIGINS=https://connect.adyapan.com

# --- OAuth ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.adyapan.com/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.adyapan.com/api/v1/auth/github/callback

# --- SMTP (for verification / reset emails) -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Adyapan Connect <no-reply@your-domain.com>

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Super admin (seeded on first run) ------------------------------------
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword!123
